{
  "version": 1,
  "settings": {
    "allowHostMutation": true,
    "allowPolicyMutation": true,
    "defaultTimeoutSeconds": 60,
    "maxOutputBytes": 1048576,
    "maxConcurrentCommands": 4,
    "strictHostKeyChecking": true,
    "auditEnabled": true,
    "auditCommandMode": "plain",
    "credentialBrokerPath": "C:\\Tools\\Helix\\helix-credential-broker.exe"
  },
  "hosts": {
    "build-key": {
      "hostname": "10.0.0.20",
      "port": 22,
      "username": "developer",
      "identityFile": "~/.ssh/id_ed25519",
      "proxyJump": null,
      "tags": ["development", "docker"],
      "allowedRemotePaths": ["/home/developer", "/workspace", "/tmp/helix", "/opt/ros"],
      "auth": {
        "type": "openssh"
      },
      "sudo": {
        "mode": "reviewed-nopasswd",
        "allow": ["^.*$"],
        "approvalTtlSeconds": 300
      }
    },
    "build-password": {
      "hostname": "10.0.0.30",
      "port": 22,
      "username": "developer",
      "tags": ["legacy", "docker"],
      "allowedRemotePaths": ["/home/developer", "/workspace", "/tmp/helix", "/opt/ros"],
      "auth": {
        "type": "windows-credential",
        "credentialRef": "Helix/ssh/build-password/login"
      },
      "sudo": {
        "mode": "reviewed-password",
        "credentialRef": "Helix/ssh/build-password/sudo",
        "allow": ["^.*$"],
        "approvalTtlSeconds": 300
      }
    }
  }
}
